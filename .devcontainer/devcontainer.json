{
  "name": "Claude Browser",
  "image": "mcr.microsoft.com/devcontainers/base:bullseye",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest",
      "noVncPort": 6080,
      "password": "claude"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Claude (browser)",
      "onAutoForward": "openBrowser"
    }
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y chromium",
  "postStartCommand": "sleep 8 && DISPLAY=:1 chromium --no-sandbox --disable-gpu --disable-dev-shm-usage 'https://claude.ai' &",
  "remoteUser": "vscode"
}
